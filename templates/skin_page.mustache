{{!
    @template mod_lesson/skin_page

    Layout regions for a skinnable Lesson page.

    Context variables required for this template:
    * skin - Normalised skin key.
    * style - Optional inline CSS custom properties.
    * globalnavigation - Lesson action/navigation HTML.
    * attemptheading - Attempt heading HTML.
    * score - Ongoing score HTML.
    * maincontentanchor - Main content anchor HTML.
    * content - Main Lesson page content HTML.
    * progress - Progress bar HTML.

    Example context (json):
    {
        "skin": "cards",
        "style": "--lesson-skin-background-colour: #ffffff",
        "hasglobalnavigation": true,
        "globalnavigation": "<div>Navigation</div>",
        "hasattemptheading": true,
        "attemptheading": "<h3>Attempt 1</h3>",
        "hasscore": true,
        "score": "<div>Score</div>",
        "maincontentanchor": "<a id=\"maincontent\"></a>",
        "content": "<form>Question</form>",
        "hasprogress": true,
        "progress": "<div>Progress</div>"
    }
}}
<div class="lesson-skin-stage lesson-skin-stage-{{skin}}"{{#style}} style="{{{style}}}"{{/style}}>
    {{#hasglobalnavigation}}
        <div class="lesson-skin-region lesson-skin-region-globalnavigation">
            {{{globalnavigation}}}
        </div>
    {{/hasglobalnavigation}}

    {{#hasattemptheading}}
        <div class="lesson-skin-region lesson-skin-region-attemptheading">
            {{{attemptheading}}}
        </div>
    {{/hasattemptheading}}

    {{#hasscore}}
        <div class="lesson-skin-region lesson-skin-region-score">
            {{{score}}}
        </div>
    {{/hasscore}}

    <div class="lesson-skin-region lesson-skin-region-main">
        {{{maincontentanchor}}}
        {{{content}}}
    </div>

    {{#hasprogress}}
        <div class="lesson-skin-region lesson-skin-region-progress">
            {{{progress}}}
        </div>
    {{/hasprogress}}
</div>
