{{!
    @template lessonappearance_scene/main

    Scene lesson appearance template.

    Renders a lesson page with a background scene, character, flag,
    and separated content blocks.

    Example context (json):
    {
        "content": "<h3>Page Title</h3><div class='contents'>Page content here</div>",
        "pagetype": "multichoice",
        "attributes": [],
        "qtypecontent": "<form>...</form>",
        "progress_bar": "<div class='progress'>50%</div>",
        "navigation_buttons": "",
        "hasbackground": true,
        "background_url": "http://example.com/bg.png",
        "hascharacter": true,
        "character_url": "http://example.com/char.png",
        "hasflag": true,
        "flag_url": "http://example.com/flag.png",
        "hassprite": false,
        "sprite_url": "",
        "hasgood": false,
        "good_url": "",
        "hasbad": false,
        "bad_url": "",
        "color_primary": "#3a5a8c",
        "color_secondary": "#6c757d",
        "color_good": "#28a745",
        "color_bad": "#dc3545",
        "color_default": "#333333"
    }
}}

<div id="id_scenecontainer" class="lessonappearance-scene"
     style="
        --scene-color-primary: {{color_primary}};
        --scene-color-secondary: {{color_secondary}};
        --scene-color-good: {{color_good}};
        --scene-color-bad: {{color_bad}};
        --scene-color-default: {{color_default}};
     "
>
    {{#hasbackground}}
    <div class="scene-background" style="background-image: url('{{background_url}}');"></div>
    {{/hasbackground}}

    <div class="scene-overlay">
        <div class="scene-progress">
            {{{progress_bar}}}
        </div>

        <div class="scene-top">
            {{#hascharacter}}
            <div class="scene-character">
                <img src="{{character_url}}" alt="" role="presentation" />
            </div>
            {{/hascharacter}}

            <div class="scene-balloon">
                <div class="scene-balloon-content no-overflow">
                    {{{content}}}
                </div>
            </div>

            {{#hasflag}}
            <div class="scene-flag">
                <img src="{{flag_url}}" alt="" role="presentation" />
            </div>
            {{/hasflag}}
        </div>

        <div id="{{pagetype}}-container" class="scene-qtype {{pagetype}}-container" {{#attributes}} {{name}}="{{value}}"{{/attributes}}>
            <div class="qtype-container">
                {{{qtypecontent}}}
            </div>
        </div>

        {{#hassprite}}
        <div class="scene-sprite">
            <img src="{{sprite_url}}" alt="" role="presentation" />
        </div>
        {{/hassprite}}

        {{#hasgood}}
        <div class="scene-feedback scene-good">
            <img src="{{good_url}}" alt="" role="presentation" />
        </div>
        {{/hasgood}}

        {{#hasbad}}
        <div class="scene-feedback scene-bad">
            <img src="{{bad_url}}" alt="" role="presentation" />
        </div>
        {{/hasbad}}

        <div class="scene-navigation">
            {{{navigation_buttons}}}
        </div>
    </div>
</div>
