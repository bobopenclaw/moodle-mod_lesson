{{!
    @template lessonappearance_base/main

    Base lesson appearance template.

    Renders a lesson page with separated content blocks.

    Example context (json):
    {
        "content": "<h3>Page Title</h3><div class='contents'>Page content here</div>",
        "pagetype": "multichoice",
        "attributes": [],
        "qtypecontent": "<form>...</form>",
        "progress_bar": "<div class='progress'>50%</div>",
        "navigation_buttons": ""
    }
}}

<div id="id_pageheadercontainer" class="fcontainer ">
    <div class="box progress_bar">
        {{{progress_bar}}}
    </div>
    <div class="contents">
        <div class="no-overflow">
            {{{content}}}
        </div>
    </div>
    <div id="{{pagetype}}-container" class="{{pagetype}}-container" {{#attributes}} {{name}}="{{value}}"{{/attributes}}>
        <div class="qtype-container">
            {{{qtypecontent}}}
        </div>
    </div>

    <div class="box navigation_buttons">
        {{{navigation_buttons}}}
    </div>
</div>